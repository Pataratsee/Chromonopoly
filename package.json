{
  "name": "chromonopoly",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/build-server.mjs && node dist-server/index.js",
    "dev:all": "node scripts/dev.mjs",
    "build": "node scripts/check-no-handmade-models.js && tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-no-handmade-models.js && vitest run",
    "test:e2e": "playwright test",
    "check:models": "node scripts/check-no-handmade-models.js",
    "check:pages": "node scripts/check-pages-build.mjs",
    "assets:download": "node scripts/download-models.mjs",
    "assets:normalize": "node scripts/normalize-model.mjs",
    "assets:compress": "node scripts/compress-models.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "bcryptjs": "^3.0.3",
    "opentype.js": "^1.3.4",
    "three": "^0.181.0",
    "troika-three-text": "^0.52.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.2",
    "@types/opentype.js": "^1.3.8",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
